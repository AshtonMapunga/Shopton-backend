# Required database connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/Shopton

# Public URLs
BASE_URL=https://your-service.onrender.com
FRONTEND_URL=https://your-frontend.example.com

# Optional Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
USE_REDIS=true

# WooCommerce
WOOCOMMERCE_BASE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_your-key
WOOCOMMERCE_CONSUMER_SECRET=cs_your-secret

# Paynow
PAYNOW_INTEGRATION_ID=your-integration-id
PAYNOW_INTEGRATION_KEY=your-integration-key
PAYNOW_RESULT_URL=https://your-service.onrender.com/api/v1/payment_route/result
PAYNOW_RETURN_URL=https://your-frontend.example.com/payment-success

# SMTP email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@example.com
